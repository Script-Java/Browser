{
	"name": "browser-ios",
	"version": "1.0.0",
	"description": "Private iOS proxy browser (Scramjet)",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"start": "node src/index.js",
		"format": "prettier --write .",
		"test": "node --test \"src/**/*.test.js\"",
		"lint": "eslint ./src/",
		"lint:fix": "eslint ./src/ --fix",
		"e2e": "playwright test"
	},
	"keywords": [
		"proxy"
	],
	"packageManager": "pnpm@10.28.0",
	"author": "",
	"license": "AGPL-3.0-or-later",
	"devDependencies": {
		"@playwright/test": "^1.64.0",
		"@simplewebauthn/server": "^14.0.3",
		"eslint": "^10.12.0",
		"prettier": "^3.9.10"
	},
	"dependencies": {
		"@duckduckgo/autoconsent": "^16.52.0",
		"@ghostery/adblocker": "^2.20.1",
		"@mercuryworkshop/bare-mux": "^2.1.9",
		"@mercuryworkshop/epoxy-transport": "2.1.28",
		"@mercuryworkshop/scramjet": "1.1.0",
		"@mercuryworkshop/wisp-js": "0.5.0",
		"@mozilla/readability": "^0.6.0",
		"@peculiar/x509": "^2.1.0",
		"dompurify": "^3.4.17",
		"esbuild": "^0.28.2",
		"express": "^5.3.0",
		"reflect-metadata": "^0.2.2",
		"socks": "^2.8.10",
		"socks-proxy-agent": "^10.1.0",
		"tldts": "^7.4.18",
		"ws": "^8.22.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	}
}
